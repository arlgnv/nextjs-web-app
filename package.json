{
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.6.2"
    }
  },
  "scripts": {
    "dev": "next dev",
    "format:check": "prettier . --check --ignore-unknown --cache --cache-location=node_modules/.cache/prettier --cache-strategy metadata",
    "format:fix": "prettier . --write --ignore-unknown --cache --cache-location=node_modules/.cache/prettier --cache-strategy metadata",
    "lint:inspect-config": "eslint --inspect-config",
    "lint:check": "eslint . --cache --cache-location=node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location=node_modules/.cache/eslint",
    "type-check": "tsc --noEmit",
    "declutter:check": "knip --config knip.config.mts --cache",
    "spell-check": "cspell .",
    "build": "next build",
    "start": "next start",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.0.8",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@commitlint/types": "20.2.0",
    "@eslint-react/eslint-plugin": "2.3.13",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.0.8",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "9.4.0",
    "eslint": "9.39.1",
    "eslint-plugin-perfectionist": "4.15.1",
    "husky": "9.1.7",
    "knip": "5.73.3",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0"
  }
}
